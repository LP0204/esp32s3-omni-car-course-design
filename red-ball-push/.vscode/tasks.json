{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Red Ball: Flash and Open Preview",
            "type": "shell",
            "command": "zsh",
            "args": [
                "${workspaceFolder}/tools/flash_and_view.sh",
                "${config:idf.port}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        }
    ]
}
